# ===================================================
# DIBLO URBAN ASSISTANCE PLATFORM - ENVIRONMENT CONFIG
# ===================================================

# Server Port & Environment
PORT=3000
NODE_ENV=production
APP_URL=https://diblo.in

# Session & JWT Signing Secret (Generate a strong 32+ character random string)
SESSION_SECRET=diblo_production_super_secret_jwt_key_2026

# Firebase Admin Service Account JSON (Raw JSON string or base64-encoded string)
# e.g. {"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}
FIREBASE_SERVICE_ACCOUNT=

# Razorpay Payment Gateway Credentials
# Never expose RAZORPAY_KEY_SECRET to the client frontend!
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Maps API Key (Optional for geocoding / live map routing)
GOOGLE_MAPS_API_KEY=

# Gemini AI API Key (Optional for assistant smart matching & support summarization)
GEMINI_API_KEY=

# Development / Preview Flags
# Set to 'false' in production to disable preview OTP fallback
ENABLE_DEMO_OTP=false
