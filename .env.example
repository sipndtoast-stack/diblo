# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Razorpay Payment Gateway Credentials (Optional in dev mock mode, required for live payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Google Maps Platform Key (Optional in dev demo mode, used for Places & Directions)
GOOGLE_MAPS_API_KEY=""

# JWT / Session Secret for Auth
SESSION_SECRET="diblo-secret-super-secure-token"

