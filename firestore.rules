rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email == 'sipndtoast@gmail.com' ||
          request.auth.token.email == 'admin@diblo.in' ||
          request.auth.token.email == 'ops.mumbai@diblo.in' ||
          request.auth.token.email.matches('^diblo\\.admin\\..*') ||
          request.auth.token.email.matches('^diblo\\.operations\\..*')
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isAssistant() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email == 'rajesh.sharma@diblo.in' ||
          request.auth.token.email.matches('^diblo\\.assistant\\..*')
        )) ||
        isAdmin()
      );
    }
    function isValidBookingStatus(status) {
      return status in [
        'pending', 'upcoming', 'confirmed', 'accepted', 'on_the_way', 'arrived', 'active', 'ongoing', 'in_progress', 'completed', 'rejected', 'cancelled', 'scheduled',
        'PENDING', 'UPCOMING', 'CONFIRMED', 'SEARCHING', 'ASSIGNED', 'ACCEPTED', 'ON_THE_WAY', 'ARRIVED', 'ACTIVE', 'ONGOING', 'OTP_VERIFIED', 'IN_PROGRESS', 'COMPLETED', 'REJECTED', 'CANCELLED', 'SCHEDULED'
      ];
    }

    // Connection test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(adminId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get, list, read: if true;
      allow create, update: if isSignedIn() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // Customers Collection
    match /customers/{customerId} {
      allow get, list, read: if true;
      allow create, update: if isSignedIn() || isOwner(customerId);
      allow delete: if isAdmin();
    }

    // Assistants Collection
    match /assistants/{assistantId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      // Allow reading and listing bookings so real-time counts and dashboards never fail during auth transitions
      allow read: if true;

      // Customers can create bookings with valid status
      allow create: if isSignedIn() && isValidBookingStatus(incoming().status);

      // Validate updates:
      // 1. Status must be valid
      // 2. Customers cannot overwrite assistantLocation once an assistant is assigned
      // 3. Assistants cannot hijack another assistant's active accepted booking
      allow update: if isSignedIn() &&
        isValidBookingStatus(incoming().status) &&
        (
          isAdmin() ||
          (
            isAssistant() && (
              !('assistantUid' in existing()) ||
              existing().assistantUid == null ||
              existing().assistantUid == '' ||
              existing().assistantUid == request.auth.uid ||
              existing().status in ['pending', 'PENDING', 'SEARCHING', 'ASSIGNED', 'rejected', 'REJECTED']
            )
          ) ||
          (
            !isAssistant() &&
            (
              ('customerId' in existing() && existing().customerId == request.auth.uid) ||
              ('customerUid' in existing() && existing().customerUid == request.auth.uid) ||
              !('customerUid' in existing())
            ) &&
            !incoming().diff(existing()).affectedKeys().hasAny(['assistantLocation'])
          )
        );

      allow delete: if isAdmin();

      // Live Assistant Location Subcollection: /bookings/{bookingId}/assistantLocation/{docId}
      match /assistantLocation/{docId} {
        allow read: if isSignedIn();
        // Customers must not be able to modify assistant location; only assistants or admins can write
        allow create, update: if isSignedIn() && (isAssistant() || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pricing Collection
    match /pricing/{pricingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Referrals Collection
    match /referrals/{referralId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Societies Collection
    match /societies/{societyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Support Tickets Collection
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Assistant Applications Collection
    match /assistantApplications/{appId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Emergency Alerts Collection
    match /emergencyAlerts/{alertId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}

